APP_URL=http://localhost:3000

# Supabase Configuration (main app database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_SECRET_KEY=

# Auth database (users, connections, sessions) — apply db/new.schema.sql here
AUTH_SUPABASE_URL=
AUTH_SUPABASE_SERVICE_SECRET_KEY=

# Discord OAuth Configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=$APP_URL/api/auth/callback/discord
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

# Telegram OIDC Configuration (get Client ID + Secret from @BotFather > Bot Settings > Web Login)
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=$APP_URL/api/auth/callback/telegram

# Authentication Configuration
JWT_SECRET=
